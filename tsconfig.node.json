{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/mcp/**/*",
    "vitest.config.ts",
    "e2e/**/*",
    "vitest.e2e.config.ts",
    "examples/build/**/*",
    "vitest.examples.config.ts",
    "vitest.compare.config.ts"
  ]
}
