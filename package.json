{
  "name": "talkie",
  "productName": "Talkie",
  "version": "1.0.0",
  "description": "Record it silent. Give it a voice.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murthy-chelankuri/talkie.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/ensureElectron.mjs && node scripts/fetchFfmpeg.mjs --ensure && electron-vite dev",
    "build": "electron-vite build && npm run build:mcp && npm run build:htmlscene && npm run build:exportpage",
    "notices": "node scripts/generateNotices.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "npm run build && vitest run -c vitest.e2e.config.ts",
    "examples:rebuild": "vitest run -c vitest.examples.config.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "postinstall": "node scripts/fetchFfmpeg.mjs",
    "package": "node scripts/fetchFfmpeg.mjs --ensure && npm run notices && npm run build && electron-builder --mac",
    "package:dir": "node scripts/fetchFfmpeg.mjs --ensure && npm run build && electron-builder --mac --dir",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "build:htmlscene": "node scripts/bundleHtmlScene.mjs",
    "build:exportpage": "node scripts/bundleExportPage.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "animejs": "^3.2.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "kokoro-js": "1.2.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.445.0",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.4",
    "sharp": "file:stubs/sharp",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "extract-zip": "2.0.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "bin": {
    "talkie-mcp": "./out/mcp/talkie-mcp.mjs"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
